// nf-core modules test brukermetricsextraction
nextflow_process {

    name "Test Process BRUKERMETRICSEXTRACTION"
    script "../main.nf"
    process "BRUKERMETRICSEXTRACTION"

    tag "modules"
    tag "modules_"
    tag "brukermetricsextraction"
    tag "untar"

    setup {
        // need to untar the file first (this is another module)
        run("UNTAR") {
            script "../../../nf-core/untar/main.nf"
            process {
                """
                input[0] = channel.of([
                    [ id:'50fmol_BSA_S1-A2_1_32.d' ],
                    file(params.macproqc_testdata_base_path + 'msspectra/50fmol_BSA_S1-A2_1_32.d.tar.bz2', checkIfExists: true)
                ])
                """
            }
        }
    }

    test("brukermetricsextraction - simple dotd folder") {

        when {
            process {
                """              
                input[0] = UNTAR.out.untar
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("brukermetricsextraction - simple dotd folder - stub") {

        options "-stub"

        when {
            process {
                """              
                input[0] = UNTAR.out.untar
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
