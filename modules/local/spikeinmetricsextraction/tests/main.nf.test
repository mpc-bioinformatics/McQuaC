// nf-core modules test spikeinmetricsextraction
nextflow_process {

    name "Test Process SPIKEINMETRICSEXTRACTION"
    script "../main.nf"
    process "SPIKEINMETRICSEXTRACTION"

    tag "modules"
    tag "modules_"
    tag "spikeinmetricsextraction"

    setup {
        run("XICEXTRACTIONCONFIG") {
            script "../../xicextractionconfig/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.macproqc_testdata_base_path + 'identifications/EXII07043std.mzTab', checkIfExists: true)
                ]
                input[1] = [
                    file(params.macproqc_testdata_base_path + 'spike_ins.csv', checkIfExists: true)
                ]
                """
            }
        }

        run("THERMOXICEXTRACTION") {
            script "../../thermoxicextraction/main.nf"
            process {
                """
                input[0] = XICEXTRACTIONCONFIG.out.config.map { meta, json, ident_csv ->
                    [
                        [ id: 'test' ],
                        file(params.macproqc_testdata_base_path + 'msspectra/small.RAW', checkIfExists: true),
                        json
                    ]
                }
                """
            }
        }
    }

    test("spikeinmetricsextraction - json - identifications - csv") {

        when {
            process {
                """
                input[0] = THERMOXICEXTRACTION.out.xic.combine(XICEXTRACTIONCONFIG.out.config).map { xic_meta, xic_json, config_meta, config_json, ident_csv ->
                    [ xic_meta, xic_json, ident_csv ]
                }
                input[1] = file(params.macproqc_testdata_base_path + 'spike_ins.csv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("spikeinmetricsextraction - json - identifications - csv - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = THERMOXICEXTRACTION.out.xic.combine(XICEXTRACTIONCONFIG.out.config).map { xic_meta, xic_json, config_meta, config_json, ident_csv ->
                    [ xic_meta, xic_json, ident_csv ]
                }
                input[1] = file(params.macproqc_testdata_base_path + 'spike_ins.csv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
