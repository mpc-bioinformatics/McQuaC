// nf-core modules test xicextractionconfig
nextflow_process {

    name "Test Process XICEXTRACTIONCONFIG"
    script "../main.nf"
    process "XICEXTRACTIONCONFIG"

    tag "modules"
    tag "modules_"
    tag "xicextractionconfig"


    test("xicextractionconfig - mzTab - csv") {

        when {
            process {
                """                
                input[0] = [
                    [ id:'test' ],
                   file(params.macproqc_testdata_base_path + 'identifications/EXII07043std.mzTab', checkIfExists: true)
                ]
                input[1] = [
                    file(params.macproqc_testdata_base_path + 'spike_ins.csv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("xicextractionconfig - mzTab - csv - stub") {

        options "-stub"

        when {
            process {
                """               
                input[0] = [
                    [ id:'test' ],
                   file(params.macproqc_testdata_base_path + 'identifications/EXII07043std.mzTab', checkIfExists: true)
                ]
                input[1] = [
                    file(params.macproqc_testdata_base_path + 'spike_ins.csv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
