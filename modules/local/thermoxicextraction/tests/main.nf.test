// nf-core modules test thermoxicextraction
nextflow_process {

    name "Test Process THERMOXICEXTRACTION"
    script "../main.nf"
    process "THERMOXICEXTRACTION"

    tag "modules"
    tag "modules_"
    tag "thermoxicextraction"


    test("thermoxicextraction - raw - json") {

        setup {
            run("XICEXTRACTIONCONFIG") {
                script "../../xicextractionconfig/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        file(params.macproqc_testdata_base_path + 'identifications/EXII07043std.mzTab', checkIfExists: true)
                    ]
                    input[1] = [
                        file(params.macproqc_testdata_base_path + 'spike_ins.csv', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = XICEXTRACTIONCONFIG.out.config.map { meta, json, ident_csv ->
                    [
                        [ id: 'test' ],
                        file(params.macproqc_testdata_base_path + 'msspectra/small.RAW', checkIfExists: true),
                        json
                    ]
                }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("thermoxicextraction - raw - json - stub") {

        options "-stub"

        setup {
            run("XICEXTRACTIONCONFIG") {
                script "../../xicextractionconfig/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test' ],
                        file(params.macproqc_testdata_base_path + 'identifications/EXII07043std.mzTab', checkIfExists: true)
                    ]
                    input[1] = [
                        file(params.macproqc_testdata_base_path + 'spike_ins.csv', checkIfExists: true)
                    ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = XICEXTRACTIONCONFIG.out.config.map { meta, json, ident_csv ->
                    [
                        [ id: 'test' ],
                        file(params.macproqc_testdata_base_path + 'msspectra/small.RAW', checkIfExists: true),
                        json
                    ]
                }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
