// nf-core modules test combinehdf5
nextflow_process {

    name "Test Process COMBINEHDF5"
    script "../main.nf"
    process "COMBINEHDF5"

    tag "modules"
    tag "modules_"
    tag "combinehdf5"
    tag "mzmlmetricsextraction"
    tag "thermometricsextraction"

    setup {
        run("MZMLMETRICSEXTRACTION") {
            script "../../mzmlmetricsextraction/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.macproqc_testdata_base_path + 'msspectra/medium_bruker.mzML', checkIfExists: true)
                ]
                """
            }
        }

        run("THERMOMETRICSEXTRACTION") {
            script "../../thermometricsextraction/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.macproqc_testdata_base_path + 'msspectra/small.RAW', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("combinehdf5 - mzml and thermo metrics") {

        when {
            process {
                """
                input[0] = MZMLMETRICSEXTRACTION.out.hdf5
                    .join(THERMOMETRICSEXTRACTION.out.hdf5)
                    .map { meta, mzml_hdf5, thermo_hdf5 -> [ meta, [ mzml_hdf5, thermo_hdf5 ] ] }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("combinehdf5 - mzml and thermo metrics - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = MZMLMETRICSEXTRACTION.out.hdf5
                    .join(THERMOMETRICSEXTRACTION.out.hdf5)
                    .map { meta, mzml_hdf5, thermo_hdf5 -> [ meta, [ mzml_hdf5, thermo_hdf5 ] ] }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
