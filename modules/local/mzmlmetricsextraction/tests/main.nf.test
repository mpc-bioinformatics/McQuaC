// nf-core modules test mzmlmetricsextraction
nextflow_process {

    name "Test Process MZMLMETRICSEXTRACTION"
    script "../main.nf"
    process "MZMLMETRICSEXTRACTION"

    tag "modules"
    tag "modules_"
    tag "mzmlmetricsextraction"

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used
    test("mzmlmetricsextraction - small mzml") {

        when {

            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.macproqc_testdata_base_path + 'msspectra/medium_bruker.mzML', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("mzmlmetricsextraction - small mzml - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.macproqc_testdata_base_path + 'msspectra/medium_bruker.mzML', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("mzmlmetricsextraction - settings from meta") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', report_up_to_charge:3, ms1_map_rt_bins:100, ms1_map_mz_bins:100 ],
                    file(params.macproqc_testdata_base_path + 'msspectra/medium_bruker.mzML', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            def command = new File(new File(process.out.hdf5[0][1]).parentFile, '.command.sh').text
            assert command.contains('-report_up_to_charge 3')
            assert command.contains('-ms1_map_rt_bins 100')
            assert command.contains('-base_peak_tic_up_to 9999')
        }

    }

}
