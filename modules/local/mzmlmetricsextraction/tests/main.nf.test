// nf-core modules test mzmlmetricsextraction
nextflow_process {

    name "Test Process MZMLMETRICSEXTRACTION"
    script "../main.nf"
    process "MZMLMETRICSEXTRACTION"

    tag "modules"
    tag "modules_"
    tag "mzmlmetricsextraction"

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used
    test("mzmlmetricsextraction - small mzml") {

        config "./nextflow.config"

        when {

            process {
                """              
                input[0] = [
                    [ id:'test' ],
                    file(params.macproqc_testdata_base_path + 'msspectra/medium_bruker.mzML', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("mzmlmetricsextraction - small mzml - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.macproqc_testdata_base_path + 'msspectra/medium_bruker.mzML', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
