nextflow_process {

    name "Test Process PIA_ANALYSIS"
    script "../main.nf"
    process "PIA_ANALYSIS"

    tag "modules"
    tag "modules_"
    tag "pia"
    tag "pia/analysis"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/nextflow.config", checkIfExists: true),
                    file("${projectDir}/nf-test.config", checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
