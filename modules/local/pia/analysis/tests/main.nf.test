nextflow_process {

    name "Test Process PIA_ANALYSIS"
    script "../main.nf"
    process "PIA_ANALYSIS"

    tag "modules"
    tag "modules_"
    tag "comet"
    tag "openms/decoydatabase"
    tag "pia"
    tag "pia/configure"
    tag "pia/compilexml"
    tag "pia/analysis"

    setup {
        run("OPENMS_DECOYDATABASE") {
            script "../../../../nf-core/openms/decoydatabase/main.nf"
            process {
                """
                input[0] = channel.of([
                    [ id:'test_db' ],
                    file(params.modules_testdata_base_path + 'proteomics/database/yeast_UPS.fasta', checkIfExists: true),
                ])
                """
            }
        }

        run("COMET") {
            script "../../../../nf-core/comet/main.nf"

            process {
                """
                def originalParams = file(params.modules_testdata_base_path + 'proteomics/parameter/OVEMB150205.comet.params', checkIfExists: true)
                def modifiedParams = new File('./modified.comet.params')
                modifiedParams.text = originalParams.text
                    .replaceAll('(?m)^output_percolatorfile =.*', 'output_percolatorfile = 0')
                    .replaceAll('(?m)^output_txtfile =.*', 'output_txtfile = 0')
                    .replaceAll('(?m)^output_mzidentmlfile =.*', 'output_mzidentmlfile = 1')

                input[0] = OPENMS_DECOYDATABASE.out.decoy_fasta.map { meta, fasta ->
                    [
                        [ id:'test'],
                        file(params.modules_testdata_base_path + 'proteomics/msspectra/OVEMB150205_12.mzML', checkIfExists: true),
                        fasta,
                        file(modifiedParams),
                    ]
                }
                """
            }
        }

        run("PIA_COMPILEXML") {
            script "../../compilexml/main.nf"
            process {
                """
                input[0] = COMET.out.mzid
                """
            }
        }

        run("PIA_CONFIGURE") {
            script "../../configure/main.nf"
            process {
                """
                input[0] = channel.of(
                    [
                        id: 'all-mztab',
                        psm_export: true,
                        peptide_export: true,
                        protein_export: true,
                        fdr_filter: true,
                        remove_decoys: true,
                        fdr_threshold: 0.01,
                        psm_export_format: 'mzTab'
                    ],
                    [
                        id: 'psm-mzid',
                        psm_export: true,
                        peptide_export: false,
                        protein_export: false,
                        fdr_filter: true,
                        remove_decoys: false,
                        fdr_threshold: 0.05,
                        psm_export_format: 'mzid'
                    ]
                )
                """
            }
        }
    }

    test("pia-analysis - all exports mzTab") {

        when {
            process {
                """
                input[0] = PIA_COMPILEXML.out.pia_xml.combine(
                    PIA_CONFIGURE.out.pia_json
                        .filter { meta, _json -> meta.id == 'all-mztab' }
                        .map { _meta, json -> json }
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                {
                    // briefly check the PIA exports
                    assert snapshot(
                        file(process.out.psms[0][1]).name,
                        file(process.out.psms[0][1]).readLines().count { it.stripLeading().startsWith("PSM") },
                        file(process.out.peptides[0][1]).name,
                        file(process.out.peptides[0][1]).readLines().count { it.stripLeading().startsWith("PSM") },
                        file(process.out.peptides[0][1]).readLines().count { it.stripLeading().startsWith("PEPTIDE") },
                        file(process.out.proteins[0][1]).name,
                        file(process.out.proteins[0][1]).readLines().count { it.stripLeading().startsWith("PRT") },
                        file(process.out.proteins[0][1]).readLines().count { it.stripLeading().startsWith("PSM") }
                    ).match("pia-analysis-all-exports-mztab")
                },
            )
        }

    }

    test("pia-analysis - PSMs only as mzid") {

        when {
            process {
                """
                input[0] = PIA_COMPILEXML.out.pia_xml.combine(
                    PIA_CONFIGURE.out.pia_json
                        .filter { meta, _json -> meta.id == 'psm-mzid' }
                        .map { _meta, json -> json }
                )
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.peptides.size() == 0 : "peptides should not be exported" },
                { assert process.out.proteins.size() == 0 : "proteins should not be exported" },
                {
                    // check the mzid file name and count some elements
                    assert snapshot(
                        file(process.out.psms[0][1]).name,
                        file(process.out.psms[0][1]).readLines().count { it.stripLeading().startsWith("<SpectrumIdentificationItem ") }
                    ).match("pia-analysis-psms-only-mzid")
                },
            )
        }

    }

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/nextflow.config", checkIfExists: true),
                    file("${projectDir}/nf-test.config", checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
