// nf-core modules test thermoheaderextraction
nextflow_process {

    name "Test Process THERMOHEADEREXTRACTION"
    script "../main.nf"
    process "THERMOHEADEREXTRACTION"

    tag "modules"
    tag "modules_"
    tag "thermoheaderextraction"

    test("thermoheaderextraction - simple raw file") {

        when {
            process {
                """              
                input[0] = [
                    [ id:'test' ],
                    file(params.macproqc_testdata_base_path + 'msspectra/small.RAW', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("thermoheaderextraction - thermo_raw - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.macproqc_testdata_base_path + 'msspectra/small.RAW', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
