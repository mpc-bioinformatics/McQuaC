// TODO nf-core: Once you have added the required tests, please run the following command to build this file:
// nf-core modules test thermoheaderextraction
nextflow_process {

    name "Test Process THERMOHEADEREXTRACTION"
    script "../main.nf"
    process "THERMOHEADEREXTRACTION"

    tag "modules"
    tag "modules_"
    tag "thermoheaderextraction"

    test("thermoheaderextraction - thermo_raw") {

        when {
            process {
                """
                // TODO nf-core: define inputs of the process here. Example:
                
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'EX09644std.raw', checkIfExists: true),
                ]
                input[1] = "test"
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
                //TODO nf-core: Add all required assertions to verify the test output.
                // See https://nf-co.re/docs/developing/testing/assertions for more information and examples.
            )
        }

    }

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used but keep the " - stub" suffix.
    test("thermoheaderextraction - thermo_raw - stub") {

        options "-stub"

        when {
            process {
                """
                // TODO nf-core: define inputs of the process here. Example:
                
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
