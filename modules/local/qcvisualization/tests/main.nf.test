
nextflow_process {

    name "Test Process QCVISUALIZATION"
    script "../main.nf"
    process "QCVISUALIZATION"

    tag "modules"
    tag "modules_"
    tag "qcvisualization"

    test("qcvisualization - default params") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                    file(params.macproqc_testdata_base_path + 'visualization/EXII01980std.hdf5', checkIfExists: true),
                    file(params.macproqc_testdata_base_path + 'visualization/EXII01990std.hdf5', checkIfExists: true),
                    ]
                ]
                input[1] = 'testfiles'   // output folder
                input[2] = file('${projectDir}/assets/default_configs/spike_ins_whole_proforma.csv', checkIfExists: true)
                input[3] = 'plotly'   // figure_format
                input[4] = 'csv'      // output_table_type
                input[5] = true       // spikeins
                input[6] = 'sec'      // rt_unit
                input[7] = ''         // output_column_order
                input[8] = 'MS1 feature maximum intensity,retention time,count of identified spectra,Delta_to_expected_RT'  // spikein_columns
                input[9] = 700        // height_barplots
                input[10] = 0         // width_barplots
                input[11] = 1000      // height_pca
                input[12] = 1000      // width_pca
                input[13] = 10        // height_ionmaps
                input[14] = 10        // width_ionmaps
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.jsons,
                    process.out.output_tables,
                    process.out.ms1_maps,
                    process.out.additional_plots,
                    process.out.versions
                ).match() },
            )
        }
    }

    test("qcvisualization - changed params") {
        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                    file(params.macproqc_testdata_base_path + 'visualization/EXII01980std.hdf5', checkIfExists: true),
                    file(params.macproqc_testdata_base_path + 'visualization/EXII01990std.hdf5', checkIfExists: true),
                    ]
                ]
                input[1] = 'testfiles'   // output folder
                input[2] = file('${projectDir}/assets/default_configs/spike_ins_whole_proforma.csv', checkIfExists: true)
                input[3] = 'html'     // figure_format
                input[4] = 'xlsx'     // output_table_type
                input[5] = true       // spikeins
                input[6] = 'min'      // rt_unit
                input[7] = ''         // output_column_order
                input[8] = 'MS1 feature maximum intensity,retention time,count of identified spectra,Delta_to_expected_RT'  // spikein_columns
                input[9] = 700        // height_barplots
                input[10] = 0         // width_barplots
                input[11] = 1000      // height_pca
                input[12] = 1000      // width_pca
                input[13] = 10        // height_ionmaps
                input[14] = 10        // width_ionmaps
                """
            }
        }


        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.ms1_maps,
                    process.out.versions
                ).match() },
                { assert process.out.htmls },  // html: md5 changes
                { assert process.out.output_tables },  // xlsx: md5 changes
                { assert process.out.additional_plots },   // html: md5 changes
            )
        }
    }
}
