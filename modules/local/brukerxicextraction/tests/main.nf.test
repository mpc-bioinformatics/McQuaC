// nf-core modules test brukerxicextraction
nextflow_process {

    name "Test Process BRUKERXICEXTRACTION"
    script "../main.nf"
    process "BRUKERXICEXTRACTION"

    tag "modules"
    tag "modules_"
    tag "brukerxicextraction"
    tag "untar"

    setup {
        // need to untar the .d-folder first (this is another module)
        run("UNTAR") {
            script "../../../nf-core/untar/main.nf"
            process {
                """
                input[0] = channel.of([
                    [ id:'50fmol_BSA_S1-A2_1_32.d' ],
                    file(params.macproqc_testdata_base_path + 'msspectra/50fmol_BSA_S1-A2_1_32.d.tar.bz2', checkIfExists: true)
                ])
                """
            }
        }

        run("XICEXTRACTIONCONFIG") {
            script "../../xicextractionconfig/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.macproqc_testdata_base_path + 'identifications/EXII07043std.mzTab', checkIfExists: true)
                ]
                input[1] = [
                    file(params.macproqc_testdata_base_path + 'spike_ins.csv', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("brukerxicextraction - d_folder - json") {

        when {
            process {
                """
                input[0] = UNTAR.out.untar.combine(XICEXTRACTIONCONFIG.out.config).map { untar_meta, d_folder, config_meta, json, ident_csv ->
                    [ untar_meta, d_folder, json ]
                }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("brukerxicextraction - d_folder - json - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = UNTAR.out.untar.combine(XICEXTRACTIONCONFIG.out.config).map { untar_meta, d_folder, config_meta, json, ident_csv ->
                    [ untar_meta, d_folder, json ]
                }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
