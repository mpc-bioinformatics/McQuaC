/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// Specifies any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/macproqc/'
    macproqc_testdata_base_path = 'https://raw.githubusercontent.com//mpc-bioinformatics/macproqc-test-data/main/testdata/'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true

// dev.config -- only for testing here!
process {
    withName: '(.*:)?(MZMLMETRICSEXTRACTION|THERMOMETRICSEXTRACTION|BRUKERMETRICSEXTRACTION|BRUKERXICEXTRACTION|XICEXTRACTIONCONFIG|IDMETRICSEXTRACTION|SPIKEINMETRICSEXTRACTION|COMBINEHDF5|HDF5TOMZQC|QCVISUALIZATION)' {
        container = 'ghcr.io/mpc-bioinformatics/macproqc-helpers:dev'
    }
}
