nextflow_pipeline {

    name "Test macproqc pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content (are hash-checked)
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')

            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/nf_core_macproqc_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() },
                // testing the created mzML files (counting their spectra)
                {
                    assert snapshot(
                        path("$outputDir/mzmls/").list()
                        .sort { it.getFileName().toString() }
                        .collect { mzml ->
                            [
                                mzml.getFileName().toString(),
                                mzml.readLines().count { it.stripLeading().startsWith("<spectrum ") },
                            ]
                        }
                    ).match("mzml-spectrum-counts")
                },
                // testing the search result mzid files (counting some elements)
                {
                    assert snapshot(
                        path("$outputDir/comet/").list()
                        .findAll { it.getFileName().toString().endsWith(".mzid") }
                        .sort { it.getFileName().toString() }
                        .collect { mzid ->
                            [
                                mzid.getFileName().toString(),
                                mzid.readLines().count { it.stripLeading().startsWith("<PeptideEvidence ") },
                                mzid.readLines().count { it.stripLeading().startsWith("<SpectrumIdentificationItem ") },
                            ]
                        }
                    ).match("mzid-filename-and-elementcount")
                },
            )
        }
    }
}
