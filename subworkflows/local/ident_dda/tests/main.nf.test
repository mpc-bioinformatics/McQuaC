nextflow_workflow {

    name "Test Subworkflow IDENT_DDA"
    script "../main.nf"
    workflow "IDENT_DDA"

    tag "subworkflows"
    tag "subworkflows_"
    tag "subworkflows/ident_dda"

    tag "openms/decoydatabase"
    tag "cometconfig"


    test("small ident") {

        config "./nextflow.config"

        when {
            workflow {
                """
                input[0] = file(params.modules_testdata_base_path + 'proteomics/database/yeast_UPS.fasta', checkIfExists: true)
                input[1] = false
                input[2] = file("${projectDir}/assets/default_configs/comet.params", checkIfExists: true)
                input[3] = channel.of([
                    [ id:'test-mzmlraw' ],
                    file(params.modules_testdata_base_path + 'proteomics/msspectra/OVEMB150205_12.mzML', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success}
                // TODO: add some useful tests, as soon as some files are emitted (like ID files)
                // { assert snapshot(workflow.out).match() }
            )
        }
    }
}
