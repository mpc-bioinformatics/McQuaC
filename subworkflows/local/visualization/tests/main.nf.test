nextflow_workflow {

    name "Test Subworkflow VISUALIZATION"
    script "../main.nf"
    workflow "VISUALIZATION"

    tag "subworkflows"
    tag "subworkflows_"
    tag "subworkflows/visualization"

    tag "qcvisualization"

    // TODO nf-core: Change the test name preferably indicating the test-data and file-format used
    test("Test Qc subworkflow") {

        when {
            workflow {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                    file(params.macproqc_testdata_base_path + 'visualization/EXII01980std.hdf5', checkIfExists: true),
                    file(params.macproqc_testdata_base_path + 'visualization/EXII01990std.hdf5', checkIfExists: true),
                    ]
                ]
                input[1] = 'testfiles'   // output folder
                input[2] = file('${projectDir}/assets/default_configs/spike_ins_whole_proforma.csv', checkIfExists: true)
                """
            }
        }
        then {
            assert workflow.success
            assertAll(
                { assert snapshot(
                    workflow.out.jsons,
                    workflow.out.output_tables,
                    workflow.out.ms1_maps,
                    workflow.out.additional_plots,
                    workflow.out.versions
                ).match() },
            )
        }
    }
}
